{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "packages/harness/dist",
    "rootDir": "packages",
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "packages/calibration/src/**/*.ts",
    "packages/sim/src/**/*.ts",
    "packages/harness/src/**/*.ts",
    "packages/harness/web/**/*.ts"
  ],
  "exclude": ["node_modules", "**/test/**"]
}
