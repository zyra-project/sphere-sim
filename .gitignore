node_modules/
packages/harness/dist/
out/
*.tsbuildinfo

# Builder scratch. Investigation scripts live here so they do not masquerade as
# deliverables; anything worth keeping gets promoted into a package with tests.
probe/

# Generated bench artifacts. bench-results.json is regenerated every round and
# the progress page inlines every PNG as a data URI, so it runs to several MB —
# committing either on each round would bury the actual source changes in
# history. CI uploads them as build artifacts, and the page is published
# separately for viewing.
bench-results*.json
progress/data/
progress/index.html

# The static coverage reference is deliberately NOT ignored: it is rendered once
# and never regenerated, and it is the correctness check for PARAMETERS.md §4.2
# and §4.3. Keeping it in history means a change to it shows up in a diff.
!progress/reference/
